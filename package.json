{
  "name": "digiverse",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @digiverse/web dev",
    "dev:server": "pnpm --filter @digiverse/server dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @digiverse/server db:migrate",
    "db:generate": "pnpm --filter @digiverse/server db:generate"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}

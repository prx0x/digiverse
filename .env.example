# =============================================================================
# Digiverse — .env.example
# Build Phase 1: only VITE_* values are consumed by the web app.
# Server / DB / auth variables are required from Build Phase 2 onward.
# NEVER put real secrets here. Copy to `.env` (git-ignored).
# =============================================================================

# --- General (Build Phase 2+) -----------------------------------------------
NODE_ENV=development
APP_NAME=Digiverse
PORT=4000
LOG_LEVEL=info

# --- Database (PostgreSQL) — Build Phase 2+ ---------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/digiverse

# --- Admin bootstrap (first-run only; idempotent; Build Phase 2) ------------
# The admin account is created from these values if it does not already exist.
# Choose your own strong password. Do NOT reuse any password from consider.docx.
ADMIN_BOOTSTRAP_USER_ID=CHANGE_ME_ADMIN_ID
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Sessions / security — Build Phase 2+ -----------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
SESSION_TTL_HOURS=12
COOKIE_SECURE=false            # set true in production (HTTPS)
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting — Build Phase 2+ -----------------------------------------
RATE_LIMIT_LOGIN_MAX=10        # attempts per window per IP+identifier
RATE_LIMIT_LOGIN_WINDOW_SEC=300
RATE_LIMIT_ACTIONS_MAX=60      # sensitive actions per window per user
RATE_LIMIT_ACTIONS_WINDOW_SEC=60

# --- Frontend (public values only; never put secrets in VITE_*) --------------
# Used by apps/web. API/WS URLs are unused until Build Phase 2+.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000/ws

# --- Game defaults (NON-DISPUTED operational defaults only) -----------------
# Disputed rule values (penalty X, clash/majority formulas, std-dev mode, etc.)
# are NOT set here; they live in the validated event-rules record managed in the
# admin panel. See OPEN_RULE_DECISIONS.md.
DEFAULT_ROUND_SELECTION_SECONDS=60
